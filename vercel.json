{
  "version": 2,
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/chat", "destination": "/chat.html" },
    { "source": "/settings", "destination": "/index.html?openSettings=1" },
    { "source": "/directives", "destination": "/index.html?openSettings=1&tab=settings-system-prompts-tab" },
    { "source": "/personas", "destination": "/index.html?openSettings=1&tab=settings-personas-tab" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
